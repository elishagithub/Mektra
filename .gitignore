# Release signing secrets
release/signing/

# Deliverables and local captures; source artwork remains in store-assets.
release/android/
release/screenshots/
*.apk
*.aab
Unity/.utmp/
Unity/.vs/
Unity/MemoryCaptures/

# Machine configuration and credentials are never source artifacts.
.bundle/
.env
.env.*
*.p12
*.jks
*.key
*.pem

